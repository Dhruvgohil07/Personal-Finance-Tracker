# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Every value below is a placeholder that is safe to commit.

# Where the FastAPI backend runs. The Next.js server forwards /api/v1/* there
# (next.config.mjs). Locally: uvicorn on port 8000. Required on Vercel.
API_ORIGIN=http://127.0.0.1:8000

# Optional locally, required in production: the SAME value as the backend's
# PROXY_SHARED_SECRET. The proxy signs each browser's IP with it, so the
# backend's rate limits count visitors separately (ADR 007, ADR 022).
# Empty = no IP is sent and the backend uses the connection's address.
PROXY_SHARED_SECRET=
