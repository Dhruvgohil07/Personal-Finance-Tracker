# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every value below is a placeholder that is safe to commit.

# development | test | production
ENV=development
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Matches the credentials in docker-compose.yml
DATABASE_URL=postgresql+psycopg://kharcha:kharcha@localhost:5432/kharcha
TEST_DATABASE_URL=postgresql+psycopg://kharcha:kharcha@localhost:5432/kharcha_test
REDIS_URL=redis://localhost:6379/0

# Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a DIFFERENT value for access and refresh.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# 32 random bytes, base64-encoded (AES-256-GCM key for uploaded files). Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
FILE_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Optional: leave empty and the app works without LLM categorization (Phase 4)
GROQ_API_KEY=
GROQ_MODEL=

# Optional: weekly email summaries (Phase 5)
RESEND_API_KEY=

MAX_UPLOAD_MB=10
